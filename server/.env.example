NODE_ENV=development
# optional: debug | info | warn | error | silent (default: debug in development, info otherwise)
LOG_LEVEL=
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=
# at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d
ASSEMBLYAI_API_KEY=
# assemblyai (default) or groq — the other one is the automatic fallback
ASR_PROVIDER=
# Member B's tuning knobs — starting values to tune, not fixed rules (blank = defaults shown)
# retrieval chunks: window and overlap in seconds (60 / 15)
CHUNK_SECONDS=
CHUNK_OVERLAP_SECONDS=
# topic sections: fixed_window baseline length (300), embedding_similarity threshold (0.45), minimum section (120)
TOPIC_SECTION_SECONDS=
TOPIC_SIM_THRESHOLD=
TOPIC_MIN_SEC=
# true = pass evaluation/asr/glossary.txt to the ASR provider as keyterms (prompting, not training)
ASR_USE_GLOSSARY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# relative paths are resolved from the repository root (./storage = <repo>/storage, git-ignored)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=512
